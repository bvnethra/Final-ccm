{
  "name": "final-ccm-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "super-admin",
    "application"
  ],
  "scripts": {
    "dev": "concurrently -n \"SUPER_ADMIN,APP\" -c \"cyan.bold,green.bold\" \"npm run dev:admin\" \"npm run dev:app\"",
    "dev:admin": "npm --prefix super-admin run dev",
    "dev:app": "npm --prefix application run dev",
    "build:admin": "npm --prefix super-admin run build",
    "build:app": "npm --prefix application run build",
    "build": "npm run build:admin && npm run build:app",
    "test:admin": "npm --prefix super-admin test",
    "test:app": "npm --prefix application test",
    "test": "npm run test:admin && npm run test:app",
    "test:db": "node scripts/test-db-connection.js",
    "test:verify": "node scripts/verify-all-connections.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.69.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.479.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.12",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.12",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^5.0.1"
  }
}
